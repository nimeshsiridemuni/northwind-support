# Local development placeholders only.
# Copy this file to .env, then generate JWT_SIGNING_KEY.
# Never commit .env.

MSSQL_SA_PASSWORD=Local_Dev_Password1

ASPNETCORE_ENVIRONMENT=Development

# Required by Docker Compose. Generate a random value before starting.
JWT_SIGNING_KEY=

# Used to hash passwords for demo agents without existing credentials.
DEVELOPMENT_AGENT_PASSWORD=Local_Agent_Password1

# Optional connection override when running the API directly.
# Compose supplies its own connection using the sqlserver service name.
ConnectionStrings__Default=Server=localhost,1433;Database=SupportDesk;User Id=sa;Password=Local_Dev_Password1;TrustServerCertificate=True;Encrypt=False